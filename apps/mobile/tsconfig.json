{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "types": ["node", "jest"],
    "typeRoots": ["../../node_modules/@types"],
    "paths": {
      "@/*": ["./*"],
      "@intell/shared": ["../../packages/shared/src/index.ts"]
    }
  },

  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
