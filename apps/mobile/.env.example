# Android Maps SDK key for react-native-maps PROVIDER_GOOGLE.
# Copy to apps/mobile/.env and paste your key (do not commit .env).
# Enable "Maps SDK for Android" in Google Cloud, restrict to:
#   package: org.replaceplace.intell
#   SHA-1: debug keystore fingerprint from `cd android && ./gradlew signingReport`
GOOGLE_MAPS_API_KEY=
