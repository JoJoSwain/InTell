# Public client configuration. Copy to apps/mobile/.env and fill in locally.
# Never commit .env. Names only here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
GOOGLE_MAPS_API_KEY_ANDROID=
GOOGLE_MAPS_API_KEY_IOS=
GOOGLE_MAP_ID=
# Local walk / USB test builds ONLY (adb reverse → 127.0.0.1:54321).
# Set to 1 for that release APK; leave empty for store / normal builds.
EXPO_PUBLIC_ALLOW_LOCAL_CLEARTEXT=
