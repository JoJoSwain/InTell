# Mobile (apps/mobile app.config / EAS secrets)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY_IOS=
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY_ANDROID=
EXPO_PUBLIC_GOOGLE_MAP_ID=
EXPO_PUBLIC_LINK_DOMAIN=intell.replaceplace.com
EXPO_PUBLIC_SENTRY_DSN=

# Admin (apps/admin). Never put the service role key here (ADR 0004, TECH_SPEC §4).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAP_ID=
NEXT_PUBLIC_LINK_DOMAIN=intell.replaceplace.com
SENTRY_DSN=

# Local tools only (tools/*.mjs fall back to these when `supabase status` is unavailable). Never in apps.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
