# Mobile (apps/mobile app.config / EAS secrets)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_MAP_STYLE_URL=
EXPO_PUBLIC_LINK_DOMAIN=intell.replaceplace.org
EXPO_PUBLIC_SENTRY_DSN=

# Google Maps SDK for Android (home map). Required for native/dev-client builds.
# Create at https://console.cloud.google.com/ → enable "Maps SDK for Android"
# → Credentials → API key. Restrict to package org.replaceplace.intell + debug SHA-1.
# Paste into apps/mobile/.env (gitignored), then rebuild:
#   GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_API_KEY=

# Admin (apps/admin)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_MAP_TILE_URL=
SENTRY_DSN=
